# =============== LLM ===============
# 二选一即可（OpenRouter 可访问 Anthropic/OpenAI/DeepSeek/Qwen 全家桶）

# 选项 A：OpenRouter（推荐）—— 国内可达，按量付费无月费
OPENROUTER_API_KEY=sk-or-v1-xxx

# 选项 B：Anthropic 直连 —— 需账号 & 网络可达
# ANTHROPIC_API_KEY=sk-ant-xxx

# 模型分层（OpenRouter 命名）：
#   抽取（schema 24 节点）用准的；客服回复用快的
XIMING_MODEL=anthropic/claude-sonnet-4.5             # 用于 ingestion --mode llm 抽取
XIMING_CHAT_MODEL=anthropic/claude-haiku-4.5         # 用于 /chat /chat/stream 客服回复

# Anthropic 直连时改用这些命名：
# XIMING_MODEL=claude-sonnet-4-6
# XIMING_CHAT_MODEL=claude-haiku-4-5

# =============== 资料获取 AI 工具 ===============
# Jina Reader：免 key（默认走它）；填了 key 享更高配额
JINA_API_KEY=

# Firecrawl：知乎/搜狐/小红书等强反爬站点的兜底，500 次/月免费
FIRECRAWL_API_KEY=

# Tavily：搜索 + 抽取一体化，1000 次/月免费
TAVILY_API_KEY=

# SerpAPI：百度/Google 搜索发现，付费
SERPAPI_API_KEY=

# =============== Embedding ===============
# 默认 bge-small-zh（95MB，512 维）；生产可换 bge-base/large
XIMING_EMBED_MODEL=BAAI/bge-small-zh-v1.5

# =============== Milvus（向量库）===============
# 默认 Milvus Lite（文件 data/vector.db）；生产换为远端：
# MILVUS_URI=http://milvus-host:19530
# MILVUS_URI=

# =============== OMS（订单系统对接）===============
# 没配的话工具会返回 NOT_CONFIGURED，agent 自动降级到"暂无法实时查询"
# XIMING_OMS_BASE_URL=
# XIMING_OMS_TOKEN=

# =============== 其他 ===============
# 自定义 User-Agent（默认 Ximing-CSBot/0.1）
# XIMING_CRAWLER_UA=
